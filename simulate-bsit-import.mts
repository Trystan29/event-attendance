OBE__',department:'CET',program:'BSIT',yearLevel:'1',section:'A'};try{new JSONDatabase().addStudentsBatch([...active.map(x=>x.student),probe],{matchBy:'fullName',updateFields:['studentId','fullName'],replaceExisting:true,addUnmatchedNames:[...newNames,'__CONFLICT_PROBE__'],matchOverrides:overrides});unresolved='Probe unexpectedly did not conflict';break}catch(e){if(!(e instanceof StudentIdConflictError)){unresolved=e instanceof Error?e.message:String(e);break}const rowsToSkip=[...new Set(e.conflicts.map(c=>active.find(x=>x.sourceId.toLowerCase()===c.studentId.toLowerCase())?.sourceId).filter(Boolean))];const onlyProbe=e.conflicts.every(c=>c.incomingName==='__conflict_probe__'||c.currentOwnerName==='__conflict_probe__');history.push({iteration:i+1,conflicts:e.conflicts,skipSourceIds:rowsToSkip});if(onlyProbe)break;if(!rowsToSkip.length){unresolved='No target row found for conflicts: '+JSON.stringify(e.conflicts);break}for(const id of rowsToSkip)skipped.add(id)}}
